# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# .env is git-ignored. Never commit it, never paste the key into a chat,
# and never print it. The app only ever reports whether a key is *present*.

# Free key from https://aistudio.google.com/apikey
#
# Current keys issued by AI Studio begin with "AQ." - that is Google's standard
# format now. The older "AIza" keys are being phased out, so do not treat an
# "AQ." key as wrong or as a short-lived token: it is the normal one.
GEMINI_API_KEY=

# The model name is read from here on purpose, so it is never hardcoded.
# The free tier covers the Flash and Flash-Lite families.
#
#   gemini-3.8-flash        newest stable Flash. Best answers. Use this by default.
#   gemini-3.5-flash-lite   far higher daily request limit. Use for bulk eval runs.
#
# Free-tier limits are per-account and Google does not publish them per model
# on the docs page; check yours at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.8-flash

# Stop the agent after this many tool round-trips and force a final answer.
MAX_AGENT_STEPS=5
